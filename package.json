{
  "name": "travel-harness",
  "version": "1.0.0",
  "description": "Local evidence-first travel planning desktop agent",
  "main": "./out/main/index.js",
  "author": "",
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.{ts,tsx,mjs,cjs,js,json}\" \"*.{ts,mjs,cjs,js,json,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.{ts,tsx,mjs,cjs,js,json}\" \"*.{ts,mjs,cjs,js,json,yml,yaml}\"",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "node --import tsx --test src/shared/schema/source.test.ts src/shared/schema/mcp/flight.test.ts src/shared/schema/mcp/flyai-flight.test.ts src/main/event-log.test.ts src/main/credential-store.test.ts src/main/logging.test.ts src/main/model-gateway.test.ts src/main/kernel.test.ts src/main/mcp/client.test.ts src/main/mcp/xhs-sidecar.test.ts src/main/rail-response-envelope.test.ts src/main/ipc/fixed-destination.test.ts src/main/ipc/manual-research.test.ts src/main/ipc/itinerary-route.test.ts src/main/ipc/route-research.test.ts src/main/ipc/route-d5.test.ts src/main/itinerary-route.test.ts src/main/manual-route-evidence.test.ts src/main/node-d4.test.ts src/main/route-d5.test.ts src/main/d2.test.ts src/main/d3.test.ts src/main/variflight-discovery-gate.test.ts src/main/variflight-result-gate.test.ts src/main/variflight-result-runner.test.ts src/main/variflight-semantics-classifier.test.ts src/main/variflight-semantics-gate.test.ts src/main/variflight-semantics-runner.test.ts src/main/flyai-cli-runner.test.ts src/main/flyai-flight-gate.test.ts src/main/flyai-flight-runner.test.ts src/main/d4.test.ts src/main/d4-manual-research.test.ts src/main/d4-xhs-ranking.test.ts src/main/d5.test.ts src/main/d6.test.ts src/main/d7.test.ts test/flyai-execution-entry.test.mjs test/renderer/app-shell-ui-render.test.ts test/renderer/settings-credential-ui-render.test.ts test/renderer/itinerary-route-ui-render.test.ts test/renderer/route-node-d4-ui-render.test.ts test/renderer/d4-ui-render.test.ts test/renderer/d5-ui-render.test.ts test/renderer/d6-ui-render.test.ts test/renderer/d7-ui-render.test.ts",
    "smoke:safe-storage": "electron test/electron/safe-storage-smoke.mjs",
    "smoke:d3-ui": "electron test/electron/d3-ui-smoke.mjs",
    "smoke:d3-ui:no-gpu": "electron test/electron/d3-ui-smoke.mjs --smoke-no-gpu",
    "smoke:d4-ui": "electron test/electron/d4-ui-smoke.mjs",
    "smoke:d4-ui:no-gpu": "electron test/electron/d4-ui-smoke.mjs --smoke-no-gpu",
    "smoke:d4-render": "node --import tsx --test test/renderer/d4-ui-render.test.ts",
    "smoke:itinerary-route-ui": "electron test/electron/itinerary-route-ui-smoke.mjs",
    "smoke:itinerary-route-ui:no-gpu": "electron test/electron/itinerary-route-ui-smoke.mjs --smoke-no-gpu",
    "smoke:route-node-d4-render": "node --import tsx --test test/renderer/route-node-d4-ui-render.test.ts",
    "smoke:d5-render": "node --import tsx --test test/renderer/d5-ui-render.test.ts",
    "smoke:route-d5-render": "node --import tsx --test test/renderer/route-d5-ui-render.test.ts",
    "smoke:route-d5-ui": "electron test/electron/route-d5-ui-smoke.mjs",
    "smoke:route-d5-ui:no-gpu": "electron test/electron/route-d5-ui-smoke.mjs --smoke-no-gpu",
    "smoke:d5-ui": "electron test/electron/d5-ui-smoke.mjs",
    "smoke:d5-ui:no-gpu": "electron test/electron/d5-ui-smoke.mjs --smoke-no-gpu",
    "smoke:d6-render": "node --import tsx --test test/renderer/d6-ui-render.test.ts",
    "smoke:d6-ui": "electron test/electron/d6-ui-smoke.mjs",
    "smoke:d6-ui:no-gpu": "electron test/electron/d6-ui-smoke.mjs --smoke-no-gpu",
    "smoke:d7-render": "node --import tsx --test test/renderer/d7-ui-render.test.ts",
    "smoke:d7-ui": "electron test/electron/d7-ui-smoke.mjs",
    "smoke:d7-ui:no-gpu": "electron test/electron/d7-ui-smoke.mjs --smoke-no-gpu",
    "smoke:unified-d6-d7-ui": "electron test/electron/unified-d6-d7-ui-smoke.mjs",
    "smoke:unified-d6-d7-ui:no-gpu": "electron test/electron/unified-d6-d7-ui-smoke.mjs --smoke-no-gpu",
    "smoke:d7-packaged": "node test/electron/d7-packaged-smoke.mjs",
    "smoke:flyai:path:packaged": "node test/electron/flyai-path-smoke.mjs",
    "verify:d7-exports": "node test/verify-timeline.mjs && node test/verify-no-secrets.mjs",
    "verify:d7-package": "node test/verify-package.mjs",
    "probe:rail": "tsx src/main/probes/rail.ts",
    "probe:rail:once": "tsx src/main/probes/rail-once.ts",
    "probe:variflight:discovery": "tsx src/main/probes/variflight-discovery-cli.ts",
    "probe:variflight:discovery:preview": "tsx src/main/probes/variflight-discovery-cli.ts preview",
    "probe:variflight:result": "tsx src/main/probes/variflight-result-cli.ts",
    "probe:variflight:result:preview": "tsx src/main/probes/variflight-result-preview-cli.ts",
    "probe:variflight:semantics": "tsx src/main/probes/variflight-semantics-cli.ts",
    "probe:variflight:semantics:preview": "tsx src/main/probes/variflight-semantics-preview-cli.ts",
    "probe:flyai:flight": "electron . -- --probe-flyai-flight-once",
    "probe:flyai:flight:preview": "tsx src/main/probes/flyai-flight-preview-cli.ts",
    "probe:map:once": "electron . --accept-map-once",
    "probe:hotel:once": "electron . --accept-hotel-once",
    "probe:search:once": "electron . --accept-search-once",
    "diagnose:map:structure:once": "electron . --diagnose-map-structure-once",
    "diagnose:rail:journey:structure:once": "electron . --diagnose-rail-journey-structure-once",
    "diagnose:map:ground-transfer:structure:once": "electron . --diagnose-map-ground-transfer-structure-once",
    "diagnose:hotel:lodging:structure:once": "electron . --diagnose-hotel-lodging-structure-once",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@cordisjs/timer": "0.3.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fly-ai/flyai-cli": "1.0.16",
    "@modelcontextprotocol/client": "2.0.0",
    "better-sqlite3": "13.0.3",
    "cordis": "3.18.1",
    "ulid": "3.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
